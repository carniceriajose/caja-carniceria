# Copiar este archivo como .env y completar los valores.

# Desarrollo: SQLite local. Producción: cadena de conexión de Postgres de Supabase
# (postgresql://usuario:clave@host:5432/postgres). Se convierte sola para psycopg 3.
DATABASE_URL=sqlite:///./dev.db

# OBLIGATORIO, mínimo 32 caracteres. Generar uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Duración del token en minutos (720 = 12 horas)
JWT_MINUTOS=720

# Orígenes permitidos del frontend, separados por coma
CORS_ORIGENES=http://localhost:5173

# desarrollo | produccion
ENTORNO=desarrollo

# --- ARCA (facturación electrónica) ---
# homologacion | produccion
ARCA_ENTORNO=homologacion
ARCA_CUIT=20000000001

# Desarrollo: rutas a los archivos del certificado y la clave (NUNCA los suba
# al repositorio; van fuera del proyecto). Reemplace por sus propias rutas.
ARCA_CERT=C:/ruta/a/sus/certificados/homo.crt
ARCA_KEY=C:/ruta/a/sus/certificados/homo.key

# Producción: en vez de archivos, el contenido de cada uno en base64. Si están
# presentes, tienen prioridad sobre ARCA_CERT/ARCA_KEY.
#   certutil -encode homo.crt cert.b64   (Windows, sin los saltos de línea de cabecera/pie)
#   base64 -w0 homo.crt                  (Linux/Mac)
# ARCA_CERT_BASE64=
# ARCA_KEY_BASE64=

# Datos del emisor que salen impresos en el ticket (tienen que coincidir con
# los de la constancia de inscripción en ARCA).
ARCA_RAZON_SOCIAL=Nombre o razón social
ARCA_DOMICILIO=Calle 123, Localidad, Provincia
ARCA_CONDICION_IVA=Responsable Inscripto
ARCA_INICIO_ACTIVIDADES=01/01/2020
ARCA_INGRESOS_BRUTOS=

ARCA_PUNTO_VENTA=1
# 11 = Factura C, 6 = Factura B
ARCA_TIPO_COMPROBANTE=11
# Solo se usa con Factura B (6)
ARCA_ALICUOTA_IVA=21

# Reintentos automáticos de facturas pendientes cada 1 minuto. Se apaga solo en los tests.
ARCA_TAREAS_DE_FONDO=true
